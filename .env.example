QUICKBOOKS_CLIENT_ID=your_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_client_secret_here
QUICKBOOKS_REFRESH_TOKEN=your_refresh_token_here
QUICKBOOKS_REALM_ID=your_company_id_here
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# Restriction Mode — omit or set to false to register all tools (default: all tools registered)
# QUICKBOOKS_DISABLE_WRITE=true    # suppress create_* and create-* tools
# QUICKBOOKS_DISABLE_UPDATE=true   # suppress update_* and update-* tools
# QUICKBOOKS_DISABLE_DELETE=true   # suppress delete_* and delete-* tools

# ── Multi-tenant HTTP server (Core/) ─────────────────────────────────────────
# Set to true to run the public HTTP MCP server (Core/index.ts). In this mode
# the single-tenant env guard is skipped and per-request tenant credentials are
# resolved via the injected tenant resolver (Phase 1: dev resolver using the
# QUICKBOOKS_* vars above; Phase 2+: the Neon-backed Vault).
# QBO_MULTI_TENANT=true
# PORT=8080

# ── Vault (Phase 2: Neon Postgres + AES-256-GCM) ─────────────────────────────
# Neon connection string. When set, the server resolves tenants from the Vault
# (encrypted per-tenant QB tokens) instead of the dev resolver.
# DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/dbname?sslmode=require
# 32-byte AES-256 key, base64-encoded (generate: openssl rand -base64 32)
# FINLENS_MASTER_KEY=base64_32_byte_key_here
# FINLENS_MASTER_KEY_ID=local-1
# Optional previous key for zero-downtime key rotation:
# FINLENS_MASTER_KEY_PREVIOUS=base64_previous_key
# FINLENS_MASTER_KEY_PREVIOUS_ID=local-0
