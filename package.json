{
    "name": "@Finlens/qbo-mcp-server",
    "version": "0.0.1",
    "description": "MCP server implementation for Finlens x QB Online integration",
    "license": "MIT",
    "main": "dist/index.js",
    "type": "module",
    "bin": "./dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc && shx chmod +x dist/*.js",
        "build:server": "tsc -p tsconfig.server.json",
        "start:server": "node dist-server/Core/index.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migrate:prod": "node dist-server/Core/Vault/db/migrate.js",
        "prepare": "npm run build",
        "watch": "tsc --watch",
        "lint:fix": "eslint --fix",
        "lint": "eslint .",
        "auth": "node dist/auth-server.js",
        "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
        "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
        "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.6.0",
        "@neondatabase/serverless": "^1.1.0",
        "dotenv": "^16.4.7",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.11.2",
        "intuit-oauth": "^4.0.0",
        "jose": "^6.2.8",
        "node-quickbooks": "^2.0.43",
        "open": "^9.1.0",
        "ws": "^8.21.3",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@jest/globals": "^30.3.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.13.10",
        "@types/ws": "^8.18.1",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.1.1",
        "globals": "^16.0.0",
        "jest": "^30.2.0",
        "prettier": "3.5.3",
        "shx": "^0.3.4",
        "ts-jest": "^29.4.6",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.1"
    }
}
